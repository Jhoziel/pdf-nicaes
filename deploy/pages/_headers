/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' blob:; img-src 'self' blob: data:; style-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/build-info.js
  Cache-Control: no-store

https://pdf-nicaes.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:deployment.pdf-nicaes.pages.dev/*
  X-Robots-Tag: noindex, nofollow
